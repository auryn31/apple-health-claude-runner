# Copy to 'env' and fill in your values
# cp env.example env

# ─── Race & Plan ───
RACE_DATE=2026-09-20
PLAN_START=2026-05-04

# ─── Athlete ───
ATHLETE_WEIGHT_TARGET_KG=70
MAX_HR=185

# ─── HR Zones (as % of MAX_HR) ───
HR_ZONE_PCTS=70,80,88,95

# ─── Paces ───
EASY_PACE=6:30-7:00
RACE_PACE=5:40

# ─── Weekly Schedule ───
RUN_DAYS=mon,wed,sat
GYM_DAYS=tue,thu,fri
LONG_RUN_DAY=sat

# ─── Plan Progression ───
BASE_WEEKLY_KM=20
PEAK_WEEKLY_KM=40
RACE_WEEK_KM=10
DELOAD_REDUCTION_PCT=35
QUALITY_START_WEEK=5
RACE_PACE_START_WEEK=9

# ─── Calendar Events ───
EVENT_START_HOUR=18
GYM_DURATION_MIN=90
